# LeetDeCode — Local Development Environment Variables
# These are read by Vite at build/dev time via import.meta.env.*
# Never commit real secrets here; use .env.local for secret overrides.

# ─── Backend Service URLs ────────────────────────────────────────────────────
# User / LeetCode / Friends / POTD service
VITE_USER_SERVICE_URL=http://localhost:8081

# Battle / Execute / Problem service
VITE_BATTLE_SERVICE_URL=http://localhost:8082
